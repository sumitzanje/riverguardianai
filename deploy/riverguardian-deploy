#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: riverguardian-deploy <approved-tag>" >&2
  exit 64
fi

TAG="$1"
REPO_URL="git@github-riverguardian:sumitzanje/riverguardianai.git"
ROOT_DIR="/home/arduino/.riverguardian"
MIRROR_DIR="$ROOT_DIR/repo-mirror.git"
RELEASES_DIR="$ROOT_DIR/releases"
SHARED_DIR="$ROOT_DIR/shared"
STATE_DIR="$ROOT_DIR/state"
DEPLOY_LOG="$ROOT_DIR/deploy.log"
LIVE_LINK="/home/arduino/riverguardianai"
SERVICE_NAME="riverguardian.service"
TS="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$RELEASES_DIR" "$SHARED_DIR/config" "$SHARED_DIR/data" "$SHARED_DIR/logs" "$SHARED_DIR/secrets" "$SHARED_DIR/credentials" "$STATE_DIR"

if [ ! -d "$MIRROR_DIR" ]; then
  git clone --mirror "$REPO_URL" "$MIRROR_DIR"
fi

git --git-dir "$MIRROR_DIR" fetch --prune --tags origin

if ! git --git-dir "$MIRROR_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "ERROR: tag not found: $TAG" >&2
  exit 65
fi

COMMIT="$(git --git-dir "$MIRROR_DIR" rev-list -n 1 "$TAG")"
SHORT_COMMIT="$(printf '%s' "$COMMIT" | cut -c1-12)"
STAGE_DIR="$RELEASES_DIR/${TAG}-${SHORT_COMMIT}"

if [ -d "$STAGE_DIR" ]; then
  rm -rf "$STAGE_DIR"
fi

git --git-dir "$MIRROR_DIR" worktree add --detach "$STAGE_DIR" "$TAG"

# Bind release to host state outside release directories.
mkdir -p "$STAGE_DIR/config"
rm -rf "$STAGE_DIR/data" "$STAGE_DIR/logs" "$STAGE_DIR/secrets" "$STAGE_DIR/credentials"
ln -sfn "$SHARED_DIR/data" "$STAGE_DIR/data"
ln -sfn "$SHARED_DIR/logs" "$STAGE_DIR/logs"
ln -sfn "$SHARED_DIR/secrets" "$STAGE_DIR/secrets"
ln -sfn "$SHARED_DIR/credentials" "$STAGE_DIR/credentials"

if [ ! -L "$STAGE_DIR/config/settings.json" ]; then
  rm -f "$STAGE_DIR/config/settings.json"
  ln -sfn "$SHARED_DIR/config/settings.json" "$STAGE_DIR/config/settings.json"
fi
if [ ! -L "$STAGE_DIR/.env" ]; then
  rm -f "$STAGE_DIR/.env"
  ln -sfn "$SHARED_DIR/.env" "$STAGE_DIR/.env"
fi
if [ ! -L "$STAGE_DIR/config/ambient_weather_secrets.json" ]; then
  rm -f "$STAGE_DIR/config/ambient_weather_secrets.json"
  ln -sfn "$SHARED_DIR/config/ambient_weather_secrets.json" "$STAGE_DIR/config/ambient_weather_secrets.json"
fi

PYTHON_BIN="$LIVE_LINK/.venv/bin/python"

# Validate staged code before touching the running runtime.
"$PYTHON_BIN" -m py_compile \
  "$STAGE_DIR/python/connectivity_manager.py" \
  "$STAGE_DIR/python/main_runtime.py" \
  "$STAGE_DIR/python/riverguardian_runtime.py" \
  "$STAGE_DIR/python/runtime_config.py"

"$PYTHON_BIN" -c "import sys; sys.path.insert(0, '$STAGE_DIR/python'); import connectivity_manager, main_runtime"

PREV_TARGET=""
if [ -L "$LIVE_LINK" ]; then
  PREV_TARGET="$(readlink "$LIVE_LINK")"
fi
printf '%s\n' "$PREV_TARGET" > "$STATE_DIR/previous_release_target"

# Stop runtime only after validation succeeds.
sudo systemctl stop "$SERVICE_NAME"

NEW_LINK="$ROOT_DIR/current.new"
ln -sfn "$STAGE_DIR" "$NEW_LINK"
mv -Tf "$NEW_LINK" "$LIVE_LINK"

if ! sudo systemctl start "$SERVICE_NAME"; then
  echo "ERROR: startup failed, rolling back" >&2
  if [ -n "$PREV_TARGET" ]; then
    ln -sfn "$PREV_TARGET" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$LIVE_LINK"
  fi
  sudo systemctl start "$SERVICE_NAME" || true
  exit 66
fi

if ! systemctl --no-pager --full status "$SERVICE_NAME" >/dev/null 2>&1; then
  echo "ERROR: service health check failed, rolling back" >&2
  if [ -n "$PREV_TARGET" ]; then
    sudo systemctl stop "$SERVICE_NAME" || true
    ln -sfn "$PREV_TARGET" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$LIVE_LINK"
    sudo systemctl start "$SERVICE_NAME" || true
  fi
  exit 67
fi

printf '%s tag=%s commit=%s release=%s\n' "$TS" "$TAG" "$COMMIT" "$STAGE_DIR" >> "$DEPLOY_LOG"
echo "Deploy successful: $TAG ($COMMIT)"
