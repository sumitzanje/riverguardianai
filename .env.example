# RiverGuardian AI environment template
# Copy to .env on UNO Q and fill real values. Do not commit .env.

# Device identity
DEVICE_ID=UB-01
SITE_ID=ULHAS_BRIDGE_NIKHOP

# Runtime mode
MOCK_MODE=false
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200
MONITORING_INTERVAL_SECONDS=30
MAX_RUNTIME_CYCLES=

# Risk and alert tuning (optional overrides)
DANGER_DISTANCE_CM=120.0
CRITICAL_CLEARANCE_CM=30.0
MINIMUM_RISE_RATE_CM_MIN=0.1
ORANGE_TIME_TO_UNSAFE_MIN=30.0
YELLOW_TIME_TO_UNSAFE_MIN=60.0
SEND_YELLOW_ALERTS=false
ORANGE_COOLDOWN_S=900
RED_COOLDOWN_S=300
YELLOW_COOLDOWN_S=1800

# Upload settings
# Leave MOCK for local testing. Set to SUPABASE when the two values below are filled.
UPLOAD_MODE=MOCK
SUPABASE_URL=
SUPABASE_KEY=
UPLOAD_TABLE_NAME=riverguardian_events

# Optional: use service role key for notifier worker reads
# Keep this only on trusted machine/backend, not on public clients.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function backend key alias (backend-only)
SUPABASE_SECRET_KEY=

# Telegram alerts (primary free channel from Supabase events)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_S=10

# Edge Function Telegram bot settings (backend-only, NOT on UNO Q)
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
DASHBOARD_URL=
STATUS_STALE_MIN=15

# Optional secret header for database webhook -> alert-dispatcher
ALERT_WEBHOOK_SECRET=

# Supabase alert notifier worker tuning
ALERT_NOTIFIER_POLL_SECONDS=12
ALERT_NOTIFIER_BATCH_SIZE=25
ALERT_NOTIFIER_TIMEOUT_S=10

# WhatsApp fallback (used by notifier only when Telegram fails)
WHATSAPP_FALLBACK_ENABLED=false

# WhatsApp alerts (optional)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=TWILIO
WHATSAPP_TIMEOUT_S=10

# Twilio WhatsApp provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Generic webhook provider (if WHATSAPP_PROVIDER=WEBHOOK)
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_BEARER_TOKEN=

# Modem/network settings for later connectivity manager
MODEM_AT_PORT=/dev/ttyUSB6
MODEM_BAUD=115200
MODEM_INTERFACE=enx024bb3b9ebe5
MODEM_APN=www
MODEM_RECOVERY_ENABLED=true
MODEM_RECOVERY_MIN_INTERVAL_S=20
MODEM_RECOVERY_MAX_INTERVAL_S=300
MODEM_DHCP_TIMEOUT_S=25
CONNECTIVITY_HEALTH_URL=https://api.ipify.org
CONNECTIVITY_CHECK_TIMEOUT_S=5

# Logging
LOG_LEVEL=INFO
